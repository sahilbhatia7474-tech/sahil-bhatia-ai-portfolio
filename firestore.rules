rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is the authenticated Founder (No backdoors or bypass tokens)
    function isFounder() {
      return request.auth != null && 
             (request.auth.token.email.lower() == 'sahilbhatia7474@gmail.com' ||
              request.auth.token.email.lower() == 'sahilbhatia1471@gmail.com');
    }
    
    // Public collections: anyone can read PUBLISHED items, only Founder can write or read drafts
    match /projects/{document} {
      allow read: if (resource == null || (resource.data.visibility == 'PUBLIC' && resource.data.status == 'PUBLISHED')) || isFounder();
      allow write: if isFounder();
    }

    match /aiSystems/{document} {
      allow read: if (resource == null || (resource.data.visibility == 'PUBLIC' && resource.data.status == 'PUBLISHED')) || isFounder();
      allow write: if isFounder();
    }

    match /journey/{document} {
      allow read: if (resource == null || (resource.data.visibility == 'PUBLIC' && resource.data.status == 'PUBLISHED')) || isFounder();
      allow write: if isFounder();
    }

    match /education/{document} {
      allow read: if (resource == null || (resource.data.visibility == 'PUBLIC' && resource.data.status == 'PUBLISHED')) || isFounder();
      allow write: if isFounder();
    }

    match /certificates/{document} {
      allow read: if (resource == null || (resource.data.visibility == 'PUBLIC' && resource.data.status == 'PUBLISHED')) || isFounder();
      allow write: if isFounder();
    }

    match /proof/{document} {
      allow read: if (resource == null || (resource.data.visibility == 'PUBLIC' && resource.data.status == 'PUBLISHED')) || isFounder();
      allow write: if isFounder();
    }

    match /apps/{document} {
      allow read: if (resource == null || (resource.data.visibility == 'PUBLIC' && resource.data.status == 'PUBLISHED')) || isFounder();
      allow write: if isFounder();
    }

    match /identity/{document} {
      allow read: if true;
      allow write: if isFounder();
    }

    match /hero/{document} {
      allow read: if true;
      allow write: if isFounder();
    }

    match /featuredPortrait/{document} {
      allow read: if true;
      allow write: if isFounder();
    }

    match /skills/{document} {
      allow read: if true;
      allow write: if isFounder();
    }

    match /navigation/{document} {
      allow read: if true;
      allow write: if isFounder();
    }

    // Site settings: public settings readable, sensitive/vault settings protected
    match /siteSettings/{document} {
      allow read: if true;
      allow write: if isFounder();
    }

    match /media/{document} {
      allow read: if (resource == null || resource.data.visibility == 'PUBLIC') || isFounder();
      allow write: if isFounder();
    }

    // Activity log: private to Founder only
    match /activityLog/{document} {
      allow read, write: if isFounder();
    }

    // Consultation inquiries / messages: public can submit valid inquiries, only Founder can read/manage
    match /messages/{document} {
      allow create: if request.resource.data.name is string &&
                       request.resource.data.email is string &&
                       request.resource.data.email.size() > 3;
      allow read, update, delete: if isFounder();
    }

    // Deny all other unlisted paths by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
