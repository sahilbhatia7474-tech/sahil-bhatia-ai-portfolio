rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Authoritative Founder Verification
    function isFounder() {
      return request.auth != null && 
             (request.auth.token.email.lower() == 'sahilbhatia7474@gmail.com' ||
              request.auth.token.email.lower() == 'sahilbhatia1471@gmail.com');
    }

    // Images: max 10MB (JPEG, PNG, WebP, SVG, GIF)
    function isValidImage() {
      return request.resource.contentType.matches('image/(jpeg|jpg|png|webp|svg\\+xml|gif)') &&
             request.resource.size <= 10 * 1024 * 1024;
    }

    // Videos: max 100MB (MP4, WebM)
    function isValidVideo() {
      return request.resource.contentType.matches('video/(mp4|webm|quicktime)') &&
             request.resource.size <= 100 * 1024 * 1024;
    }

    // Documents: max 25MB (PDF)
    function isValidDocument() {
      return request.resource.contentType == 'application/pdf' &&
             request.resource.size <= 25 * 1024 * 1024;
    }

    // Public portfolio visitors can read assets
    // Only authenticated Founder can write, upload, or delete assets adhering to limits
    match /{allPaths=**} {
      allow read: if true;
      allow create, update: if isFounder() && (isValidImage() || isValidVideo() || isValidDocument());
      allow delete: if isFounder();
    }
  }
}
