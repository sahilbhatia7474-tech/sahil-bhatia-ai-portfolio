rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Authoritative Founder Verification
    function isFounder() {
      return request.auth != null && 
             (request.auth.token.email.lower() == 'sahilbhatia7474@gmail.com' ||
              request.auth.token.email.lower() == 'sahilbhatia1471@gmail.com');
    }

    // Images: max 15MB (JPEG, PNG, WebP, SVG, GIF, etc.)
    function isValidImage() {
      return (request.resource == null || request.resource.contentType.matches('image/.*')) &&
             request.resource.size <= 15 * 1024 * 1024;
    }

    // Videos: max 100MB (MP4, WebM, QuickTime)
    function isValidVideo() {
      return (request.resource == null || request.resource.contentType.matches('video/.*')) &&
             request.resource.size <= 100 * 1024 * 1024;
    }

    // Documents: max 25MB (PDF and attachments)
    function isValidDocument() {
      return (request.resource == null || request.resource.contentType.matches('application/(pdf|octet-stream)')) &&
             request.resource.size <= 25 * 1024 * 1024;
    }

    // Public portfolio visitors can read assets
    // Only authenticated Founder can write, upload, or delete assets adhering to limits
    match /{allPaths=**} {
      allow read: if true;
      allow create, update: if isFounder() && (isValidImage() || isValidVideo() || isValidDocument());
      allow delete: if isFounder();
    }
  }
}
